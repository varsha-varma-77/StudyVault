{
  "name": "studyvault",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --names \"CLIENT,SERVER\" --prefix-colors \"cyan,yellow\" \"vite --port=3000 --host=0.0.0.0\" \"nodemon server/server.js\"",
    "client": "vite --port=3000 --host=0.0.0.0",
    "server": "nodemon --watch server --watch .env --ext js,mjs,json,env server/server.js",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.16.4",
    "multer": "^2.0.0",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "esbuild": "^0.28.0",
    "nodemon": "^3.1.10",
    "tailwindcss": "^4.3.3"
  }
}
